# ──────────────────────────────────────────────
# 이 파일을 .env 로 복사해서 값을 채운다.
#   cp .env.example .env
# .env 는 git에 올라가지 않는다 (.gitignore 처리됨).
# ──────────────────────────────────────────────

# Postgres (docker-compose 의 db 컨테이너 + 앱이 공유)
POSTGRES_DB=studytogether
POSTGRES_USER=studytogether
POSTGRES_PASSWORD=change-me-please

# 외부에 노출할 포트
DB_PORT=5432
APP_PORT=8080

# JPA DDL 정책 (운영: validate, 개발: update)
JPA_DDL_AUTO=update

# CORS 허용 오리진 (프론트가 올라간 주소들, 콤마 구분)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://i3inni.github.io

# 로그 레벨
LOG_LEVEL=INFO
